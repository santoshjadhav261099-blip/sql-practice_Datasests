2.find duplicate recordes from table
SELECT name, COUNT(*)
FROM employees
GROUP BY name
HAVING COUNT(*) > 1;
=============================================================================================================
3.Retrieve employees who earn more than their managers(we use self join)

select e.name as employee_name,e.salary as employee_salary,
m.name as manager_name, m.salary as manager_salary from  employees e
join employees m 
on e.manager_id=m.id
where e.salary>m.salary
